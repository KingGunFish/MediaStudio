# ===== Dependencies =====
node_modules/

# ===== Build / package outputs =====
# These contain local absolute paths (e.g. builder-debug.yml embeds
# C:\Users\<you>\...), so they must never be committed.
dist/
dist*/
out/
electron-app/build/
release/
electron-app/dist/
electron-app/dist*/
electron-app/release/
electron-app/release-build/
electron-app/out/
# Generated test outputs / .err logs (not source)
electron-app/_test/
sdk/build/
# NOTE: tools/build/ is intentionally tracked — it holds the SDK build helper
# scripts (source), not build output (output goes to sdk/build/).

# ===== Logs =====
*.log

# ===== OS / editor cruft =====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tsbuildinfo

# ===== Local / personal — MUST NOT be committed =====
# WorkBuddy memory + identity files (personal info)
.workbuddy/
# IDE workspace settings (may contain local machine paths)
.codeartsdoer/
# Local agent skill/tool directories (session-local, not project source)
.skill/
.codex/
*.bak.corrupt
*.corrupt

# ===== Prebuilt SDK binaries =====
# ms_demo.exe / libmedia_studio.dll are tracked so `npm run package` is
# out-of-the-box. The large ffmpeg/ffprobe binaries are fetched at build time
# via `npm run fetch:ffmpeg` (tools/fetch-ffmpeg.mjs) and must NOT be committed.
electron-app/resources/sdk/ffmpeg.exe
electron-app/resources/sdk/ffprobe.exe
electron-app/resources/sdk/ffplay.exe
# (ms_demo.exe and libmedia_studio.dll remain tracked)

# partial downloads (resume artifacts)
ffmpeg-lgpl.part.zip
.zcode/

# ===== HarmonyOS (OHOS) port =====
# tmp/ is the OHOS cross-build work dir: the extracted ffmpeg source tree,
# the generated clang/lld toolchain wrappers and all build outputs (~385 MB).
tmp/
# DevEco / hvigor build products and dependency trees.
harmony-app/.hvigor/
harmony-app/oh_modules/
harmony-app/entry/.cxx/
harmony-app/entry/build/
harmony-app/entry/oh_modules/
# ffmpeg artefacts staged in by tools/stage-ffmpeg-ohos.sh: the prebuilt
# shared libraries and the public headers they were built from. Both are
# regenerated by that script, so they are not source.
harmony-app/entry/libs/
harmony-app/entry/src/main/cpp/third_party/ffmpeg/
