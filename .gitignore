# ===== Dependencies =====
node_modules/

# ===== Build / package outputs =====
# These contain local absolute paths (e.g. builder-debug.yml embeds
# C:\Users\<you>\...), so they must never be committed.
dist/
dist*/
out/
electron-app/build/
release/
electron-app/dist/
electron-app/dist*/
electron-app/release/
electron-app/out/
# Generated test outputs / .err logs (not source)
electron-app/_test/
sdk/build/
# NOTE: tools/build/ is intentionally tracked — it holds the SDK build helper
# scripts (source), not build output (output goes to sdk/build/).

# ===== Logs =====
*.log

# ===== OS / editor cruft =====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tsbuildinfo

# ===== Local / personal — MUST NOT be committed =====
# WorkBuddy memory + identity files (personal info)
.workbuddy/
# IDE workspace settings (may contain local machine paths)
.codeartsdoer/
*.bak.corrupt
*.corrupt

# ===== Prebuilt SDK binaries =====
# ms_demo.exe / libmedia_studio.dll are tracked so `npm run package` is
# out-of-the-box. The large ffmpeg/ffprobe binaries are fetched at build time
# via `npm run fetch:ffmpeg` (tools/fetch-ffmpeg.mjs) and must NOT be committed.
electron-app/resources/sdk/ffmpeg.exe
electron-app/resources/sdk/ffprobe.exe
electron-app/resources/sdk/ffplay.exe
# (ms_demo.exe and libmedia_studio.dll remain tracked)
